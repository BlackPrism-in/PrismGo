NODE_ENV=development
PORT=4000

# Postgres + PostGIS from infra/docker-compose.yml
DATABASE_URL=postgresql://prismgo:prismgo@localhost:5433/prismgo?schema=public
REDIS_URL=redis://localhost:6380

# Auth
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
OTP_TTL_SECONDS=300
# Delivery order for login codes: whatsapp, console (dev only).
OTP_CHANNELS=console
WHATSAPP_OTP_TEMPLATE=login_code
# Trip notifications: console (dev, logs to the API) or whatsapp
MESSAGING_PROVIDER=console

# Web app origin for CORS
WEB_ORIGIN=http://localhost:5173

# Integrations (filled in as client access arrives)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
GOOGLE_MAPS_SERVER_KEY=
# Shared secret the GPS vendor / adapter / simulator sends as X-GPS-Secret
GPS_WEBHOOK_SECRET=change-me-gps
# Pull live positions from the GPS vendor's API (Trakzee). Empty = off (webhook/simulator only).
# Check the connection first with: pnpm --filter @prismgo/api gps:check
GPS_PULL_PROVIDER=
GPS_PULL_INTERVAL_S=15
GPS_VENDOR_BASE_URL=http://165.22.222.196/webservice
GPS_VENDOR_USERNAME=
GPS_VENDOR_PASSWORD=
GPS_VENDOR_PROJECT_ID=37
# Company name exactly as on the vendor account
GPS_VENDOR_COMPANY=
# Vendor timestamps are local time without a zone
GPS_VENDOR_TIME_ZONE=+05:30
# Mobile push (Firebase project prismgo-34a61): service-account key JSON, raw or base64.
# Empty = push off (in-app and WhatsApp still work).
FCM_SERVICE_ACCOUNT_JSON=
